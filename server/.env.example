# ---------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------

# --- Church Community Builder / Pushpay ChMS (API v1) ---
# Confirmed against https://docs.pushpay.io/chms-v1/docs/getting-started —
# this API uses HTTP Basic Auth with a dedicated API username/password
# issued from ChMS itself (Setup → API Admin). This is a service-account
# credential for server-to-server data access — NOT an individual member's
# personal CCB login, and never collected from a member on this site.
CCB_API_URL=https://gacny.ccbchurch.com/api.php
CCB_API_USERNAME=
CCB_API_PASSWORD=

# This API has no OAuth2/SSO flow, so "Member Login" is a direct link on
# the frontend to the church's own ChMS login page — this site never
# authenticates members itself, and there's no backend route for it.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.example-gac-domain.org
PORT=3000

# --- YouTube (Sermons / Watch Live) ---
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# --- Giving ---
GIVING_URL=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- Analytics (privacy-conscious; no PII) ---
ANALYTICS_ID=
